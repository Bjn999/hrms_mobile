# ==============================================================================
# BJN HRMS Mobile - Environment Configuration Example
# ==============================================================================
# تعليمات الاستخدام:
# 1. انسخ هذا الملف وأعد تسميته إلى: .env
# 2. ضع رابط خادم الباك إند (Laravel API) أمام المتغير API_BASE_URL.
# 
# أمثلة لضبط رابط الـ API:
# - في بيئة الإنتاج (Production / الدومين الحقيقي):
#   API_BASE_URL=https://your-domain.com/api
#
# - في بيئة التطوير المحلية (هاتف حقيقي متصل بنفس شبكة الـ Wi-Fi):
#   API_BASE_URL=http://192.168.1.X:8000/api  (استبدل X برقم الـ IP الخاص بجهازك)
#
# - في بيئة التطوير على محاكي الأندرويد (Android Emulator):
#   API_BASE_URL=http://10.0.2.2:8000/api
# ==============================================================================

# رابط خادم الـ API الأساسي (يجب أن ينتهي بـ /api)
API_BASE_URL=http://10.0.2.2:8000/api

# بيئة التطبيق (development أو production)
APP_ENV=development

# إصدار التطبيق
APP_VERSION=1.0.0
